# Copy as deploy/.env, or pass these values to Docker Compose.
# The default installation listens on the Docker host's loopback interface only.
# No extra services, build tools, credentials or OIDC provider are required.
#
# Image tags:
#   edge       latest passing main-branch build (development/pre-release)
#   1.0.0      explicit semver release
#   latest     most recently released stable version (when available)
QUILLDNS_IMAGE_TAG=edge

# DNS listener and resolver client access policy.
QUILLDNS_DNS_LISTEN=127.0.0.1:1053
QUILLDNS_ALLOW_NETWORKS=127.0.0.0/8,::1/128
QUILLDNS_UPSTREAMS=1.1.1.1:53,8.8.8.8:53

# Without OIDC the UI is deliberately restricted to loopback.
QUILLDNS_HTTP_LISTEN=127.0.0.1:8080

# Optional: configure all OIDC values together to enable authenticated UI access.
# Put secrets in an ignored local .env file, not in a committed Compose file.
#QUILLDNS_OIDC_ISSUER=https://id.example.com/realms/home
#QUILLDNS_OIDC_CLIENT_ID=quilldns
#QUILLDNS_OIDC_CLIENT_SECRET=REPLACE_ME
#QUILLDNS_PUBLIC_URL=https://dns.example.com
#QUILLDNS_OIDC_ALLOWED_EMAILS=admin@example.com
